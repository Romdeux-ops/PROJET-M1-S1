# Copier en .env.local pour surcharger localement (non versionne).

# URL absolue du backend. Laisser vide en dev : Vite proxifie /api vers localhost:8080.
VITE_API_URL=

# true = API simulee par MSW (equivalent a `npm run dev:mock`).
VITE_ENABLE_MOCKS=false

# Cible du proxy de dev (lue par vite.config.ts, pas exposee au navigateur).
# VITE_API_PROXY_TARGET=http://localhost:8080

# Adresse publique de l'application, encodee dans le QR code d'un coach. Laisser vide en production
# (l'adresse du site est utilisee). En dev, mettre l'IP du poste pour scanner avec un telephone :
# VITE_PUBLIC_URL=http://192.168.1.20:5173
VITE_PUBLIC_URL=
