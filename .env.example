# Copier ce fichier en .env puis adapter si besoin.
# Les memes valeurs alimentent docker-compose.yml et application.yml.

DB_NAME=fitcoach
DB_USER=fitcoach
DB_PASSWORD=fitcoach
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/fitcoach

SERVER_PORT=8080

# Profil Spring. ./gradlew bootRun utilise dev s'il est absent ; obligatoire
# pour tout autre lancement (aucun profil par defaut dans application.yml).
SPRING_PROFILES_ACTIVE=dev

# Fuseau des notions metier (aujourd'hui, semaine courante).
APP_TIME_ZONE=Europe/Paris

# Origines autorisees pour le frontend React (Vite ecoute sur 5173 par defaut).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

PGADMIN_EMAIL=admin@fitcoach.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# JWT (phase 2). A changer hors developpement local, 32 caracteres minimum.
JWT_SECRET=dev-only-secret-key-please-rotate-32bytes-min
JWT_EXPIRATION_MINUTES=60
